# Environment variables for local testing
# Copy this file to .env and fill in your values

# Kit subscriber broadcasts and post-send verification
KIT_API_KEY=
KIT_SENDER_EMAIL=
KIT_SCHEDULE_DELAY_MINUTES=5
KIT_SEND_VERIFICATION_GRACE_MINUTES=30

# Scheduled-run dead-man switch (store as a GitHub Actions secret in production)
HEALTHCHECKS_PING_URL=

# Public UserJot project identifier used by the generated feedback widget
USERJOT_PROJECT_ID=

# Local repository and optional target override
LOCAL_REPO_PATH=/path/to/memdocs
TARGET_REPO_OWNER=MicrosoftDocs
TARGET_REPO_NAME=memdocs

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
OPENAI_SUMMARY_REASONING_EFFORT=xhigh
OPENAI_SUMMARY_CONCURRENCY=3
OPENAI_SUMMARY_ENABLED=true

# Shared Intune Scout Discord incoming webhook
DISCORD_INTUNE_SCOUT_WEBHOOK_URL=
DISCORD_INTUNE_SCOUT_NAME=Intune Scout
DISCORD_INTUNE_SCOUT_AVATAR_URL=
DISCORD_ENABLED=true
DISCORD_DRY_RUN=true
